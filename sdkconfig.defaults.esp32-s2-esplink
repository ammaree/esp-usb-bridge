# This file is used to pass ESPLink_S2 specific options when building firmware for the probe
# To pass it to the build system, set the SDKCONFIG_DEFAULTS environment environment variable like so:
# export SDKCONFIG_DEFAULTS="sdkconfig.defaults.esp32-s2-esplink;sdkconfig.defaults.esp32s2"

CONFIG_BRIDGE_PRODUCT_NAME="ESPLink_S2"

CONFIG_SERIAL_HANDLER_GPIO_BOOT=34
CONFIG_SERIAL_HANDLER_GPIO_RST=33
CONFIG_SERIAL_HANDLER_GPIO_RXD=6
CONFIG_SERIAL_HANDLER_GPIO_TXD=5

CONFIG_DEBUG_PROBE_GPIO_TDI=36
CONFIG_DEBUG_PROBE_GPIO_TDO=35
CONFIG_DEBUG_PROBE_GPIO_TCK=38
CONFIG_DEBUG_PROBE_GPIO_TMS=37

# 1=TX  2=RX  3=JTAG
CONFIG_BRIDGE_GPIO_LED1=12
CONFIG_BRIDGE_GPIO_LED2=3
CONFIG_BRIDGE_GPIO_LED3=21

# 0=Active LOW, 1=Active HIGH
CONFIG_BRIDGE_GPIO_LED1_ACTIVE=1
CONFIG_BRIDGE_GPIO_LED2_ACTIVE=1
CONFIG_BRIDGE_GPIO_LED3_ACTIVE=1

# Note: D1 (red, GPIO12, TX activity) is absent from the schematic BOM and may be
# unpopulated on some ESPLink v1.2 boards; those simply show no TX-activity LED.
